// Windose Control Test Suite
// Tests all new GUI controls: ProgressBar, RadioButton, ComboBox, TabControl, Slider, Tooltip
// Plus existing controls: Button, TextField, Checkbox, ListView, TreeView, etc.

process("ControlTest")

let win = window("Windose Control Test", 50, 50, 700, 550)
let root = windowRoot(win)

// ===== TAB CONTROL =====
let tabs = tabControl("", 680, 480)
add(root, tabs)

// ============================================================
// TAB 1: Progress & Sliders
// ============================================================
let tab1 = tabAdd(tabs, "Progress & Sliders")
let stack1 = stackPanel("vertical")
add(tab1, stack1)

// ProgressBar - determinate
let pLabel1 = panel("Determinate ProgressBar:", 20)
add(stack1, pLabel1)
let progress1 = progressBar("", 300, 25)
add(stack1, progress1)

// ProgressBar - indeterminate
let pLabel2 = panel("Indeterminate ProgressBar:", 20)
add(stack1, pLabel2)
let progress2 = progressBar("", 300, 25)
progressIndeterminate(progress2, true)
add(stack1, progress2)

// ProgressBar with text
let pLabel3 = panel("ProgressBar with text:", 20)
add(stack1, pLabel3)
let progress3 = progressBar("Loading...", 300, 25)
set(progress3, "fontSize", 12)
add(stack1, progress3)

// Slider - horizontal
let sLabel1 = panel("Horizontal Slider:", 20)
add(stack1, sLabel1)
let slider1 = slider("Volume", 300, 25)
sliderRange(slider1, 0, 100)
add(stack1, slider1)

// Slider - with value display
let sLabel2 = panel("Slider with ticks:", 20)
add(stack1, sLabel2)
let slider2 = slider("Brightness", 300, 25)
sliderRange(slider2, 0, 255)
set(slider2, "showTicks", true)
add(stack1, slider2)

// ============================================================
// TAB 2: Selection Controls
// ============================================================
let tab2 = tabAdd(tabs, "Selection Controls")
let stack2 = stackPanel("vertical")
add(tab2, stack2)

// RadioButtons
let rbLabel = panel("RadioButton Group (Color):", 20)
add(stack2, rbLabel)

let rbStack = stackPanel("horizontal")
add(stack2, rbStack)

let rbRed = radioButton("Red", "color")
add(rbStack, rbRed)

let rbGreen = radioButton("Green", "color")
add(rbStack, rbGreen)

let rbBlue = radioButton("Blue", "color")
add(rbStack, rbBlue)

// Checkboxes
let cbLabel = panel("Checkboxes:", 20)
add(stack2, cbLabel)

let cbStack = stackPanel("horizontal")
add(stack2, cbStack)

let cb1 = checkbox("Option A")
add(cbStack, cb1)

let cb2 = checkbox("Option B")
add(cbStack, cb2)

let cb3 = checkbox("Option C")
add(cbStack, cb3)

// ComboBox
let comboLabel = panel("ComboBox (Font Selection):", 20)
add(stack2, comboLabel)

let fontCombo = comboBox("Select Font", 200)
comboAdd(fontCombo, "Arial")
comboAdd(fontCombo, "Times New Roman")
comboAdd(fontCombo, "Courier New")
comboAdd(fontCombo, "Verdana")
comboAdd(fontCombo, "Segoe UI")
add(stack2, fontCombo)

// ============================================================
// TAB 3: File & List Controls
// ============================================================
let tab3 = tabAdd(tabs, "File & List Controls")
let stack3 = stackPanel("vertical")
add(tab3, stack3)

// ListView
let lvLabel = panel("ListView (icons mode):", 20)
add(stack3, lvLabel)

let listView1 = listView("icons")
add(stack3, listView1)

listItem(listView1, "Documents", "0:\\Documents", true)
listItem(listView1, "Pictures", "0:\\Pictures", true)
listItem(listView1, "Music", "0:\\Music", true)
listItem(listView1, "readme.txt", "0:\\readme.txt", false)
listItem(listView1, "startup.breeze", "0:\\startup.breeze", false)

// TreeView
let tvLabel = panel("TreeView:", 20)
add(stack3, tvLabel)

let treeView1 = treeView()
add(stack3, treeView1)

let root1 = treeRoot(treeView1, "My Computer", "computer")
let driveC = treeChild(root1, "Local Disk (C:)", "c:")
treeChild(driveC, "Windows", "c:\\windows")
treeChild(driveC, "Programs", "c:\\programs")
let drive0 = treeChild(root1, "System (0:)", "0:")
treeChild(drive0, "System", "0:\\System")
treeChild(drive0, "Services", "0:\\System\\Services")

// ============================================================
// TAB 4: Buttons & Actions
// ============================================================
let tab4 = tabAdd(tabs, "Buttons & Actions")
let stack4 = stackPanel("vertical")
add(tab4, stack4)

let actionLabel = panel("Action Buttons:", 20)
add(stack4, actionLabel)

// Progress control buttons
let btnStack1 = stackPanel("horizontal")
add(stack4, btnStack1)

let btnInc = button("+10% Progress", 120, 30)
add(btnStack1, btnInc)

let btnDec = button("-10% Progress", 120, 30)
add(btnStack1, btnDec)

let btnReset = button("Reset", 80, 30)
add(btnStack1, btnReset)

// Slider control buttons
let btnStack2 = stackPanel("horizontal")
add(stack4, btnStack2)

let btnSliderUp = button("Slider +10", 100, 30)
add(btnStack2, btnSliderUp)

let btnSliderDown = button("Slider -10", 100, 30)
add(btnStack2, btnSliderDown)

// Combo control buttons
let btnStack3 = stackPanel("horizontal")
add(stack4, btnStack3)

let btnComboGet = button("Get Combo Selection", 160, 30)
add(btnStack3, btnComboGet)

let btnRadioGet = button("Get Radio Selection", 160, 30)
add(btnStack3, btnRadioGet)

// Status display
let statusLabel = panel("Status:", 20)
add(stack4, statusLabel)

let statusField = textField("Ready", 30)
set(statusField, "width", 400)
add(stack4, statusField)

// ============================================================
// TAB 5: Tooltip Demo
// ============================================================
let tab5 = tabAdd(tabs, "Tooltip Demo")
let stack5 = stackPanel("vertical")
add(tab5, stack5)

let tipLabel = panel("Hover over these buttons to see tooltips:", 20)
add(stack5, tipLabel)

let tip = tooltip()

let tipStack = stackPanel("horizontal")
add(stack5, tipStack)

let btnSave = button("Save", 100, 30)
tooltipAttach(tip, btnSave, "Saves the current document (Ctrl+S)")
add(tipStack, btnSave)

let btnOpen = button("Open", 100, 30)
tooltipAttach(tip, btnOpen, "Opens an existing file (Ctrl+O)")
add(tipStack, btnOpen)

let btnPrint = button("Print", 100, 30)
tooltipAttach(tip, btnPrint, "Prints the current document (Ctrl+P)")
add(tipStack, btnPrint)

let btnDelete = button("Delete", 100, 30)
tooltipAttach(tip, btnDelete, "Permanently deletes the selected item")
add(tipStack, btnDelete)

let tipNote = panel("Tooltips appear after hovering for 500ms", 20)
add(stack5, tipNote)

// ============================================================
// EVENT HANDLERS
// ============================================================

// ProgressBar buttons
on btnInc "click" => {
    let current = value(progress1, "value")
    if current < 100 {
        progressValue(progress1, current + 10)
        set(progress3, "text", "Loading... " + (current + 10) + "%")
    }
    set(statusField, "text", "Progress increased to " + (current + 10) + "%")
}

on btnDec "click" => {
    let current = value(progress1, "value")
    if current > 0 {
        progressValue(progress1, current - 10)
        set(progress3, "text", "Loading... " + (current - 10) + "%")
    }
    set(statusField, "text", "Progress decreased to " + (current - 10) + "%")
}

on btnReset "click" => {
    progressValue(progress1, 0)
    set(progress3, "text", "Loading... 0%")
    set(statusField, "text", "Progress reset to 0%")
}

// Slider buttons
on btnSliderUp "click" => {
    let current = value(slider1, "value")
    sliderValue(slider1, current + 10)
    set(statusField, "text", "Slider set to " + (current + 10))
}

on btnSliderDown "click" => {
    let current = value(slider1, "value")
    sliderValue(slider1, current - 10)
    set(statusField, "text", "Slider set to " + (current - 10))
}

// Combo button
on btnComboGet "click" => {
    let selected = comboText(fontCombo)
    let index = comboSelected(fontCombo)
    if selected != "" {
        set(statusField, "text", "Selected font: " + selected + " (index " + index + ")")
    } else {
        set(statusField, "text", "No font selected")
    }
}

// Radio button
on btnRadioGet "click" => {
    let redChecked = radioChecked(rbRed)
    let greenChecked = radioChecked(rbGreen)
    let blueChecked = radioChecked(rbBlue)

    if redChecked {
        set(statusField, "text", "Selected color: Red")
    } else if greenChecked {
        set(statusField, "text", "Selected color: Green")
    } else if blueChecked {
        set(statusField, "text", "Selected color: Blue")
    } else {
        set(statusField, "text", "No color selected")
    }
}

// Slider value changed
on slider1 "change" => {
    let val = value(slider1, "value")
    set(statusField, "text", "Slider value: " + val)
}

// Combo selection changed
on fontCombo "change" => {
    let selected = comboText(fontCombo)
    set(statusField, "text", "Font changed to: " + selected)
}

// Radio button changes
on rbRed "change" => {
    set(statusField, "text", "Color changed to Red")
}

on rbGreen "change" => {
    set(statusField, "text", "Color changed to Green")
}

on rbBlue "change" => {
    set(statusField, "text", "Color changed to Blue")
}

// ListView selection
on listView1 "select" => {
    let item = value(event, "text")
    let path = value(event, "path")
    set(statusField, "text", "Selected: " + item + " (" + path + ")")
}

// TreeView selection
on treeView1 "select" => {
    let item = value(event, "text")
    set(statusField, "text", "Tree selected: " + item)
}

// ============================================================
// TIMER: Auto-animate the indeterminate progress bar
// ============================================================
let animTimer = timer(100)
on animTimer "tick" => {
    // Auto-increment the determinate progress bar in a loop
    let current = value(progress1, "value")
    if current >= 100 {
        progressValue(progress1, 0)
    } else {
        progressValue(progress1, current + 1)
    }
    set(progress3, "text", "Loading... " + (current + 1) + "%")
}
startTimer(animTimer)

// Show the window
show(win)